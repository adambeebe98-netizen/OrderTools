# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public base URL, used for team links and push notification click targets
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random secret used to hash client IPs for rate limiting (e.g. `openssl rand -hex 32`)
RATE_LIMIT_SALT=

# --- Web Push (generate with `npx web-push generate-vapid-keys`) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL you control)
VAPID_SUBJECT=mailto:admin@example.com
